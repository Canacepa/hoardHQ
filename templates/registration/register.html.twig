{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block body %}
<main class="flex-1 flex items-center justify-center p-8">
    <div class="clay clay-form w-full max-w-md !p-8">
        {% for flash_error in app.flashes('verify_email_error') %}
            <div class="clay-inset !rounded-2xl px-4 py-3 mb-4 text-sm font-bold text-[var(--clay-accent-deep)]" role="alert">{{ flash_error }}</div>
        {% endfor %}

        <h1 class="text-3xl">Inscription</h1>

        {{ form_errors(registrationForm) }}

        {{ form_start(registrationForm) }}
            {{ form_row(registrationForm.username) }}
            {{ form_row(registrationForm.email) }}
            {{ form_row(registrationForm.plainPassword, {
                label: 'Password'
            }) }}
            {{ form_row(registrationForm.agreeTerms) }}

            <twig:Button type="submit" size="lg" class="mt-6 w-full">S'inscrire</twig:Button>
        {{ form_end(registrationForm) }}
    </div>
</main>
{% endblock %}
