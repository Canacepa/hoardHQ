{% extends 'layout/app.html.twig' %}

{% block title %} - Add item{% endblock %}

{% block content %}
<h1 class="text-[40px]">Add an item to {{ collection.name }}</h1>
<section class="neu max-w-xl rounded-[32px] p-7 [&_input]:inset [&_input]:w-full [&_input]:rounded-2xl [&_input]:px-4 [&_input]:py-3 [&_input]:outline-none [&_label]:mb-1 [&_label]:block [&_label]:text-sm [&_label]:font-semibold [&_button]:wine [&_button]:h-[52px] [&_button]:rounded-[18px] [&_button]:px-6 [&_button]:font-semibold [&_div]:mb-4">
    {{ form_start(form) }}
    {{ form_widget(form, {attr: {class: ''}}) }}
    {{ form_end(form) }}
</section>
<twig:Button as="a" variant="link" href="{{ path('app_collections_show', {id: collection.id}) }}" class="h-auto self-start px-0 font-semibold text-wine">← Back to {{ collection.name }}</twig:Button>
{% endblock %}
