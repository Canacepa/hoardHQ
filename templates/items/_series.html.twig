{# Body of a book series' modal on the import page, loaded the first time it opens. Params: key, volumes (not in the collection yet),
   total (all the volumes found), missing (numbers Google Books has no record of), complete (false when the lookup ran out of time),
   error. The buttons and checkboxes belong to the import form that wraps the page: submitting from here adds everything ticked
   on the page. #}
{% set label = 'text-xs font-semibold uppercase tracking-[.14em] text-muted-ink' %}
<turbo-frame id="series-{{ key }}">
    {% if error %}
        <p role="alert" class="text-sm text-destructive">{{ error }}</p>
    {% elseif total == 0 %}
        <p class="text-muted-ink">Google Books has no numbered volumes for this series.</p>
    {% else %}
        <div class="flex flex-col gap-7">
            {% if volumes %}
                <section class="inset flex flex-wrap items-center justify-between gap-4 rounded-2xl p-5" aria-label="Full series">
                    <p class="min-w-0">
                        <span class="block font-semibold">The full series</span>
                        <span class="text-sm text-muted-ink">
                            {% if volumes|length == total %}All {{ total }} volume{{ total != 1 ? 's' : '' }}{% else %}The {{ volumes|length }} volume{{ volumes|length != 1 ? 's' : '' }} you don't have yet{% endif %},
                            each added as its own item
                        </span>
                    </p>
                    {# Volumes ticked below are not added twice: the series already adds them. #}
                    <twig:Button type="submit" name="externalId[]" value="bookseries:{{ key }}" variant="wine" size="md"><twig:ux:icon name="heroicons:plus" class="size-5" />Add full series</twig:Button>
                </section>
            {% endif %}

            {% if missing or not complete %}
                <p class="text-sm text-muted-ink" role="status">
                    {% if missing %}Google Books has no record of {{ missing|length }} volume{{ missing|length != 1 ? 's' : '' }} in between ({{ missing|slice(0, 12)|join(', ') }}{{ missing|length > 12 ? '…' : '' }}).{% endif %}
                    {% if not complete %}The lookup ran out of time, so more volumes may exist; open this again in a minute.{% endif %}
                </p>
            {% endif %}

            <section class="flex flex-col gap-3" aria-label="Volumes">
                <h3 class="{{ label }}">Or pick volumes</h3>
                {% if volumes %}
                    <ul class="flex flex-col gap-3">
                        {% for volume in volumes %}
                            <li class="inset rounded-2xl has-[:checked]:ring-2 has-[:checked]:ring-wine/60">
                                <label class="flex cursor-pointer items-center gap-3 p-3">
                                    <twig:Checkbox name="externalId[]" value="{{ volume.externalId }}" />
                                    {% if volume.attributes.poster %}
                                        <img src="{{ volume.attributes.poster }}" alt="" loading="lazy" class="h-20 w-14 flex-none rounded-lg object-cover">
                                    {% else %}
                                        <span class="neu-sm flex h-20 w-14 flex-none items-center justify-center rounded-lg font-serif text-xl text-wine" aria-hidden="true">{{ volume.attributes.volume }}</span>
                                    {% endif %}
                                    <span class="min-w-0">
                                        <span class="block font-semibold">{{ volume.name }}</span>
                                        <span class="block text-sm text-muted-ink">Volume {{ volume.attributes.volume }}{% if volume.attributes.year %} · {{ volume.attributes.year }}{% endif %}</span>
                                    </span>
                                </label>
                            </li>
                        {% endfor %}
                    </ul>
                    <twig:Button type="submit" variant="neu" size="md" class="self-start"><twig:ux:icon name="heroicons:plus" class="size-5" />Add selected volumes</twig:Button>
                {% else %}
                    <p class="text-sm text-muted-ink">All of its volumes are already in this collection.</p>
                {% endif %}
            </section>
        </div>
    {% endif %}
</turbo-frame>
