{% extends 'base.html.twig' %}

{% block title %}Bonjour {{ user.username }}{% endblock %}

{% block body %}

<div class="container">
    <h1>Bonjour {{ user.username }}!</h1>
    {% if user.collectionsOwned|length > 0 %}
        <p>Voici vos collections :</p>
        <div class="collections flex gap-4">
            {% for collection in user.collectionsOwned %}
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">{{ collection.name }}</h5>
                        <p class="card-text">{{ collection.description }}</p>
                        <a href="/collections/{{ collection.id }}" class="btn btn-primary">Voir la collection</a>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <p>Vous n'avez pas encore de collections. Créez-en une dès maintenant !</p>
    {% endif %}

    <div>
        <twig:Button variant="default" as="a" href="/collections/new">+
                Create Collection
        </twig:Button>
    </div>

</div>
{% endblock %}
