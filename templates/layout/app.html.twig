{% extends 'base.html.twig' %}

{# Authenticated shell. Phone: header + floating bottom nav. Tablet (sm): icon rail. Desktop (lg): full sidebar. Child templates fill `content`. #}
{% block body %}
<div class="flex h-dvh w-full flex-col gap-4 p-4 sm:flex-row sm:gap-7 sm:p-7">
    <a href="{{ path('app_home') }}" class="flex items-center gap-3 sm:hidden">
        <span class="neu-sm flex size-11 items-center justify-center rounded-[14px] font-serif text-[22px] font-semibold text-wine" aria-hidden="true">H</span>
        <span class="font-serif text-[22px] font-semibold tracking-tight">Hoard<span class="text-wine">HQ</span></span>
    </a>

    <aside class="glass hidden shrink-0 flex-col items-center gap-7 overflow-y-auto rounded-[32px] px-3 py-5 sm:flex sm:w-[76px] lg:w-72 lg:items-stretch lg:p-6">
        <a href="{{ path('app_home') }}" aria-label="HoardHQ" class="flex items-center gap-3.5">
            <span class="neu-sm flex size-12 shrink-0 items-center justify-center rounded-2xl font-serif text-2xl font-semibold text-wine" aria-hidden="true">H</span>
            <span class="hidden font-serif text-[25px] font-semibold tracking-tight lg:inline">Hoard<span class="text-wine">HQ</span></span>
        </a>
        <twig:Navbar />
        <div class="grow"></div>
        <twig:Button as="a" variant="wine" size="xl" href="/collections/new" aria-label="New collection" class="w-14 px-0 hover:opacity-95 lg:w-auto lg:px-6"><twig:ux:icon name="heroicons:plus-circle" class="size-[22px]" /><span class="hidden lg:inline">New collection</span></twig:Button>
    </aside>

    <main class="flex min-h-0 min-w-0 flex-1 flex-col gap-8 overflow-y-auto p-2 pb-32 sm:p-5 [&>*]:shrink-0">
        {% block content %}{% endblock %}
        <footer class="mt-auto flex justify-end"><a href="{{ path('app_legal') }}" class="text-xs text-muted-ink underline-offset-2 hover:underline">Legal notice</a></footer>
    </main>

    {# Back link: pinned bottom-left of the content area, clear of the sidebar and of the floating mobile nav. Children fill `back`. #}
    {% set backLink %}{% block back %}{% endblock %}{% endset %}
    {% if backLink|trim %}
        <div class="fixed bottom-[calc(max(1.25rem,env(safe-area-inset-bottom))+84px)] left-6 z-10 sm:bottom-7 sm:left-[152px] lg:left-[364px]">{{ backLink }}</div>
    {% endif %}

    <twig:Navbar mobile />
</div>
{% endblock %}
