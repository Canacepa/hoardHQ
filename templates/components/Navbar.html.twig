{% set route = app.current_route %}
{% set tints = ['var(--clay-accent)', 'var(--clay-sec)', 'var(--clay-sec2)', 'var(--clay-sec3)'] %}
{% if app.user %}
    <aside class="md:w-60 md:shrink-0 md:min-h-dvh p-4 flex md:flex-col items-center md:items-stretch gap-1" style="background: var(--clay-bg-deep)">
        <a href="{{ path('user_profile', {slug: app.user.userIdentifier}) }}" class="flex items-center gap-2.5 px-3 pb-0 md:pb-5 pt-1">
            <span class="clay-btn-primary size-9 !rounded-xl grid place-items-center font-display text-lg">H</span>
            <span class="font-display text-xl">HoardHQ</span>
        </a>
        {% set links = [
            {label: 'Dashboard', path: path('user_profile', {slug: app.user.userIdentifier}), route: 'user_profile'},
            {label: 'Collections', path: path('app_collections'), route: 'app_collections'},
            {label: 'Objets', path: path('app_items'), route: 'app_items'},
        ] %}
        <nav class="flex md:flex-col gap-1 flex-1 md:flex-none" aria-label="Navigation">
            {% for l in links %}
                <a href="{{ l.path }}" {% if route == l.route %}aria-current="page"{% endif %}
                   class="px-3.5 py-2.5 rounded-2xl text-[13px] {{ route == l.route ? 'clay-sm font-extrabold' : 'font-semibold text-[var(--clay-ink-soft)] hover:bg-[var(--clay-surface)]/50' }}">{{ l.label }}</a>
            {% endfor %}
        </nav>
        {% if app.user.collectionsOwned|length > 0 %}
            <div class="hidden md:block flex-1">
                <p class="px-3.5 pt-5 pb-2 text-[10px] font-extrabold uppercase tracking-wider text-[var(--clay-ink-faint)]">Étagères</p>
                {% for c in app.user.collectionsOwned %}
                    <a href="{{ path('app_collections_show', {id: c.id}) }}" class="flex items-center gap-2.5 px-3.5 py-2 text-xs font-semibold text-[var(--clay-ink-soft)]">
                        <span class="size-2.5 rounded-full" style="background: {{ tints[loop.index0 % tints|length] }}"></span>
                        <span class="truncate">{{ c.name }}</span>
                    </a>
                {% endfor %}
            </div>
        {% endif %}
        <twig:Button as="a" href="{{ path('app_logout') }}" variant="secondary" size="sm" class="md:mt-auto">Déconnexion</twig:Button>
    </aside>
{% else %}
    <nav class="clay !py-3 !px-6 mx-4 mt-4 flex items-center justify-between gap-3">
        <a href="{{ path('app_home') }}" class="flex items-center gap-2.5">
            <span class="clay-btn-primary size-9 !rounded-xl grid place-items-center font-display text-lg">H</span>
            <span class="font-display text-xl">HoardHQ</span>
        </a>
        <div class="flex items-center gap-3">
            <twig:Button as="a" href="{{ path('app_login') }}" variant="secondary">Connexion</twig:Button>
            <twig:Button as="a" href="{{ path('app_register') }}">Inscription</twig:Button>
        </div>
    </nav>
{% endif %}
