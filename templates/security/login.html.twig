{% extends 'layout/auth.html.twig' %}

{% block title %} - Log in{% endblock %}

{% block form %}
<header class="flex flex-col gap-1.5">
    <h1 class="text-[36px] leading-[1.1]">Log in</h1>
    <p class="text-muted-ink">Welcome back to your collection.</p>
</header>

<form method="post" class="flex flex-col gap-4">
    {% if error %}
        <div role="alert" class="rounded-2xl bg-destructive/10 px-4 py-3 text-sm text-destructive">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}
    {% if app.user %}
        <p class="text-sm">Signed in as {{ app.user.userIdentifier }}, <a class="font-semibold text-wine underline" href="{{ logout_path() }}" data-turbo-prefetch="false">Log out</a></p>
    {% endif %}
    <div class="flex flex-col gap-1.5">
        <label for="username" class="text-sm font-semibold">Username</label>
        <input type="text" value="{{ last_username }}" name="_username" id="username" class="inset h-[54px] rounded-full px-5 outline-none" autocomplete="username" required autofocus>
    </div>
    <div class="flex flex-col gap-1.5">
        <label for="password" class="text-sm font-semibold">Password</label>
        <input type="password" name="_password" id="password" class="inset h-[54px] rounded-full px-5 outline-none" autocomplete="current-password" required>
    </div>
    <div class="flex items-center gap-3">
        <twig:Checkbox name="_remember_me" id="remember_me" />
        <label for="remember_me" class="text-sm font-semibold">Remember me</label>
    </div>
    <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">
    <twig:Button type="submit" variant="wine" size="xl" class="mt-2">Log in</twig:Button>
</form>

<p class="text-center text-sm text-muted-ink">No account yet? <a href="{{ path('app_register') }}" class="font-semibold text-wine underline underline-offset-4">Sign up</a></p>
{% endblock %}
