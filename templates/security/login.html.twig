{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
<div class="mx-auto flex min-h-dvh max-w-md items-center p-7">
    <form method="post" class="glass flex w-full flex-col gap-4 rounded-[32px] p-8">
        <h1 class="text-[32px]">Connexion</h1>
        {% if error %}
            <div role="alert" class="rounded-2xl bg-destructive/10 px-4 py-3 text-sm text-destructive">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}
        {% if app.user %}
            <p class="text-sm">Connecté en tant que {{ app.user.userIdentifier }}, <a class="text-wine underline" href="{{ logout_path() }}">Déconnexion</a></p>
        {% endif %}
        <label for="username" class="text-sm font-semibold">Nom d'utilisateur</label>
        <input type="text" value="{{ last_username }}" name="_username" id="username" class="inset rounded-full px-5 py-3 outline-none" autocomplete="username" required autofocus>
        <label for="password" class="text-sm font-semibold">Mot de passe</label>
        <input type="password" name="_password" id="password" class="inset rounded-full px-5 py-3 outline-none" autocomplete="current-password" required>
        <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">
        <button type="submit" class="wine mt-2 h-[52px] rounded-[18px] font-semibold">Se connecter</button>
    </form>
</div>
{% endblock %}
