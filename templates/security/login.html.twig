{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
<main class="flex-1 flex items-center justify-center p-8">
    <form method="post" class="clay clay-form w-full max-w-md !p-8">
        {% if error %}
            <div class="clay-inset !rounded-2xl px-4 py-3 mb-4 text-sm font-bold text-[var(--clay-accent-deep)]">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        {% if app.user %}
            <div class="mb-3 text-sm">
                Connecté en tant que {{ app.user.userIdentifier }}, <a class="underline font-bold" href="{{ logout_path() }}">Déconnexion</a>
            </div>
        {% endif %}

        <h1 class="text-3xl">Connexion</h1>
        <label for="username">Nom d'utilisateur</label>
        <input type="text" value="{{ last_username }}" name="_username" id="username" autocomplete="username" required autofocus>
        <label for="password">Mot de passe</label>
        <input type="password" name="_password" id="password" autocomplete="current-password" required>
        <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

        <twig:Button type="submit" size="lg" class="mt-6 w-full">Se connecter</twig:Button>
    </form>
</main>
{% endblock %}
