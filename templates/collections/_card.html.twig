{# Optional params: showCategory (adds the category tag, used by the grid display), selectable (the collections list in edit mode can tick it). #}
{% import '_macros/category.html.twig' as cat %}
{% set selectable = selectable|default(false) %}
{% if selectable %}<div class="relative rounded-[28px] transition-shadow has-[:checked]:ring-2 has-[:checked]:ring-wine/70">{% endif %}
<a href="/collections/{{ collection.id }}" class="neu group flex flex-col gap-4 rounded-[28px] p-5 transition-transform hover:-translate-y-0.5{{ selectable ? ' h-full' : '' }}"{{ selectable ? ' data-selection-inert' : '' }}>
    <div class="inset flex h-[124px] items-center justify-center overflow-hidden rounded-[20px]" aria-hidden="true">
        {% if collection.coverUrl %}<img src="{{ collection.coverUrl }}" alt="" loading="lazy" class="size-full object-cover">{% else %}<span class="flex size-[72px] items-center justify-center font-serif text-4xl font-semibold text-wine">{% if collection.visibleCategory %}<twig:ux:icon name="{{ cat.icon(collection.visibleCategory.name) }}" class="size-15" />{% else %}{{ collection.name|first|upper }}{% endif %}</span>{% endif %}
    </div>
    <div class="min-w-0">
        <h2 class="truncate text-[21px]">{{ collection.name }}</h2>
        <p class="line-clamp-2 min-h-10 text-sm text-muted-ink">{{ collection.description }}</p>
    </div>
    {% if showCategory|default(false) and collection.visibleCategory %}
        <span class="inset inline-flex max-w-full items-center gap-1.5 self-start rounded-full px-3 py-1.5 text-xs font-semibold text-wine"><twig:ux:icon name="{{ cat.icon(collection.visibleCategory.name) }}" class="size-4 shrink-0" /><span class="truncate">{{ collection.visibleCategory.name }}</span></span>
    {% endif %}
</a>
{% if selectable %}
    {% include 'collections/_pick.html.twig' with {collection: collection, rounded: 'rounded-[28px]', pos: 'left-4 top-4'} only %}
</div>
{% endif %}
