{# Edit mode for a list of cards with checkboxes: an Edit button which, once pressed, gives way to Select all, an action dropdown,
   Confirm and Cancel. Cards can be ticked straight away; the action can be picked at any point before Confirm. Used for the items of a
   collection and for the collections list, so both look and work the same.
   Needs an ancestor with class group/sel and data-controller="selection", and a form with id "bulk" for Confirm to submit.
   Params: actions (list of {kind, label, icon}), label (what Edit edits, for screen readers), noun (what the actions apply to). #}
<twig:Button type="button" variant="neu" size="pill" data-action="selection#start" aria-label="{{ label }}" title="{{ label }}" class="group-data-[selecting]/sel:hidden"><twig:ux:icon name="heroicons:pencil-square" class="size-5" /></twig:Button>
<div class="hidden flex-wrap items-center gap-3 group-data-[selecting]/sel:flex">
    <twig:Button type="button" variant="neu" size="pill" data-selection-target="all" data-selection-clear-text="Deselect all" data-action="selection#toggleAll">Select all</twig:Button>
    <details class="relative" data-controller="dropdown" data-selection-target="menu">
        <summary class="neu-sm flex h-12 cursor-pointer list-none items-center gap-2 rounded-full px-5 text-sm font-semibold text-wine outline-none focus-visible:ring-2 focus-visible:ring-wine/40 [&::-webkit-details-marker]:hidden">
            <span data-selection-target="label">Choose an action</span><twig:ux:icon name="heroicons:chevron-down" class="size-4" />
        </summary>
        <div role="menu" aria-label="Action for the selected {{ noun }}" class="neu absolute right-0 top-full z-20 mt-3 flex w-56 flex-col gap-0.5 rounded-[24px] p-2">
            {% for action in actions %}
                <button type="button" role="menuitem" data-action="selection#choose" data-selection-kind-param="{{ action.kind }}" data-selection-label-param="{{ action.label }}" class="flex w-full cursor-pointer items-center gap-3 rounded-xl px-3 py-2.5 text-left text-sm font-semibold text-wine outline-none hover:bg-white/35 focus-visible:ring-2 focus-visible:ring-wine/40"><twig:ux:icon name="heroicons:{{ action.icon }}" class="size-[18px] shrink-0" />{{ action.label }}</button>
            {% endfor %}
        </div>
    </details>
    <twig:Button type="submit" form="bulk" variant="wine" size="pill" data-selection-target="apply" data-action="selection#validate" disabled>Confirm</twig:Button>
    <twig:Button type="button" variant="neu" size="pill" data-action="selection#cancel">Cancel</twig:Button>
</div>
