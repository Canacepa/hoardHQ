{% extends 'layout/app.html.twig' %}

{% block title %} - Edit {{ collection.name }}{% endblock %}

{% block back %}
    <twig:Button as="a" variant="neu" size="md" href="{{ path('app_collections_show', {id: collection.id}) }}">← Back to {{ collection.name }}</twig:Button>
{% endblock %}

{% block content %}
<h1 class="text-[40px]">Edit {{ collection.name }}</h1>
{# Only the owner can delete (contributors can edit); the button and its confirmation window live in the form. #}
{% include 'collections/_form.html.twig' with {form: form, submit_label: 'Save changes', deletable: isOwner ? collection : null} only %}
{% endblock %}
