{% extends 'layout/app.html.twig' %}

{% block title %} - Browse{% endblock %}

{% block content %}
<div class="flex flex-wrap items-center justify-between gap-x-8 gap-y-5">
<header class="flex flex-col gap-1.5">
    <h1 class="text-[46px] leading-[1.1]">Public collections</h1>
</header>

<form method="get" action="{{ path('app_browse') }}" role="search" class="flex min-w-[260px] flex-1 items-center justify-end gap-3 sm:max-w-md">
    <label class="inset flex h-12 min-w-0 flex-1 items-center gap-2.5 rounded-full px-5 text-muted-ink focus-within:ring-2 focus-within:ring-wine/40">
        <twig:ux:icon name="heroicons:magnifying-glass" class="size-5 shrink-0" />
        <span class="sr-only">Search public collections</span>
        <input type="search" name="q" value="{{ q }}" placeholder="Search by name, description or collector" class="min-w-0 flex-1 bg-transparent text-base text-ink outline-none placeholder:text-muted-ink/80">
    </label>
    {% if q %}
        <twig:Button as="a" variant="link" href="{{ path('app_browse') }}" class="h-auto px-0 font-semibold text-wine">Clear</twig:Button>
    {% endif %}
</form>
</div>

{% if popular|length %}
<section aria-label="Popular collections" class="flex flex-col gap-5" data-controller="carousel">
    <div class="flex items-center justify-between gap-4">
        <h2 class="text-[28px]">Popular</h2>
        <div class="flex gap-3">
            <twig:Button variant="neu" aria-label="Previous collection" class="size-11 rounded-full p-0" data-action="carousel#prev"><twig:ux:icon name="heroicons:chevron-left" class="size-5" /></twig:Button>
            <twig:Button variant="neu" aria-label="Next collection" class="size-11 rounded-full p-0" data-action="carousel#next"><twig:ux:icon name="heroicons:chevron-right" class="size-5" /></twig:Button>
        </div>
    </div>
    <div data-carousel-target="track" class="-mx-5 flex snap-x [scrollbar-width:none] [&::-webkit-scrollbar]:hidden snap-mandatory scroll-px-5 gap-6 overflow-x-auto px-5 pb-8 [&>*]:shrink-0">
        {% for collection in popular %}
            <article class="relative flex min-h-[260px] w-[min(100%,720px)] snap-start flex-wrap items-center gap-8 overflow-hidden rounded-[36px] p-9 text-[#fbf3e6]" style="background:linear-gradient(135deg,#8a3a44 0%,#722f37 45%,#4a1d24 100%);box-shadow:12px 12px 28px rgb(114 47 55/.32),-8px -8px 22px rgb(255 252 243/.5)">
                <div aria-hidden="true" class="absolute -top-28 -right-14 size-[360px] rounded-full bg-[radial-gradient(circle,rgb(183_168_154/.65),transparent_70%)]"></div>
                <div class="relative flex min-w-[220px] flex-1 flex-col gap-4">
                    <span class="text-xs font-semibold uppercase tracking-[.14em] text-[#fbf3e6]/85">Popular · {{ collection.followers|length }} follower{{ collection.followers|length != 1 ? 's' : '' }}</span>
                    <h3 class="text-[34px] leading-[1.1]">{{ collection.name }}</h3>
                    <p class="line-clamp-2 max-w-md text-base text-[#fbf3e6]/90">{{ collection.description }}</p>
                    <div class="mt-1 flex flex-wrap items-center gap-3">
                        <twig:Button as="a" variant="cream" size="md" href="{{ path('app_collections_show', {id: collection.id}) }}">Open collection</twig:Button>
                        <span class="text-sm text-[#fbf3e6]/85">By <a href="{{ path('user_profile', {slug: collection.owner.username}) }}" class="font-semibold underline underline-offset-2">{{ collection.owner.username }}</a></span>
                    </div>
                </div>
                {% if collection.visibleCategory %}
                <div class="glass-dark relative rounded-[24px] px-5 py-4 font-semibold">{{ collection.visibleCategory.name }}</div>
                {% endif %}
            </article>
        {% endfor %}
    </div>
</section>
{% endif %}

{% if q %}
    <p class="text-muted-ink">{{ collections|length }} result{{ collections|length != 1 ? 's' : '' }} for “{{ q }}”</p>
{% endif %}

<section aria-label="Public collections" class="grid gap-6 [grid-template-columns:repeat(auto-fill,minmax(min(220px,100%),1fr))]">
    {% for collection in collections %}
        {% include 'collections/_card.html.twig' %}
    {% else %}
        <p class="col-span-full text-muted-ink">{{ q ? 'Nothing matches your search.' : 'No public collections yet.' }}</p>
    {% endfor %}
</section>
{% endblock %}
