{# One collection as a row, for the list display. Columns are fixed so the rows line up, and the narrower the screen the fewer there are.
   In edit mode the row gets extra left padding: that gutter is where the checkbox goes, so it never sits on the icon tile. #}
{% import '_macros/category.html.twig' as cat %}
{% set items = collection.entries|length %}
{% set selectable = selectable|default(false) %}
{% if selectable %}<div class="relative rounded-[24px] transition-shadow has-[:checked]:ring-2 has-[:checked]:ring-wine/70">{% endif %}
<a href="/collections/{{ collection.id }}" class="neu grid grid-cols-[3.5rem_1fr] items-center gap-4 rounded-[24px] px-4 py-3 transition-[transform,padding] hover:-translate-y-0.5 group-data-[selecting]/sel:pl-14 sm:grid-cols-[3.5rem_1fr_5.5rem_1.25rem] md:grid-cols-[3.5rem_1fr_11rem_5.5rem_1.25rem] lg:grid-cols-[3.5rem_1fr_11rem_5.5rem_7rem_1.25rem]"{{ selectable ? ' data-selection-inert' : '' }}>
    <span class="inset flex size-14 items-center justify-center overflow-hidden rounded-2xl text-wine" aria-hidden="true">
        {% if collection.coverUrl %}<img src="{{ collection.coverUrl }}" alt="" loading="lazy" class="size-full object-cover">{% elseif collection.visibleCategory %}<twig:ux:icon name="{{ cat.icon(collection.visibleCategory.name) }}" class="size-6" />{% else %}<span class="font-serif text-2xl font-semibold">{{ collection.name|first|upper }}</span>{% endif %}
    </span>
    <span class="min-w-0">
        <span class="block truncate text-lg font-semibold">{{ collection.name }}</span>
        <span class="block truncate text-sm text-muted-ink">{{ collection.description ?: (collection.visibleCategory ? collection.visibleCategory.name : 'No description') }}</span>
    </span>
    <span class="hidden md:block">
        {% if collection.visibleCategory %}
            <span class="inset inline-flex max-w-full items-center gap-1.5 rounded-full px-3 py-1.5 text-xs font-semibold text-wine"><twig:ux:icon name="{{ cat.icon(collection.visibleCategory.name) }}" class="size-4 shrink-0" /><span class="truncate">{{ collection.visibleCategory.name }}</span></span>
        {% endif %}
    </span>
    <span class="hidden text-right text-sm text-muted-ink sm:block"><span class="font-semibold text-ink">{{ items }}</span> item{{ items != 1 ? 's' : '' }}</span>
    <span class="hidden text-right text-sm text-muted-ink lg:block">{{ collection.updatedAt|date('M j, Y') }}</span>
    <span class="hidden text-muted-ink sm:block" title="{{ collection.public ? 'Public' : 'Private' }}">
        <twig:ux:icon name="heroicons:{{ collection.public ? 'globe-alt' : 'lock-closed' }}" class="size-5" /><span class="sr-only">{{ collection.public ? 'Public' : 'Private' }}</span>
    </span>
</a>
{% if selectable %}
    {% include 'collections/_pick.html.twig' with {collection: collection, rounded: 'rounded-[24px]', pos: 'left-4 top-1/2 -translate-y-1/2'} only %}
</div>
{% endif %}
