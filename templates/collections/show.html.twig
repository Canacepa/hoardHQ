{% extends 'layout/app.html.twig' %}

{% import '_macros/category.html.twig' as cat %}

{% block title %} - {{ collection.name }}{% endblock %}

{% block content %}
<div class="flex flex-wrap items-center gap-3">
    <twig:Button as="a" variant="link" href="{{ path(isOwner ? 'app_collections' : 'app_browse') }}" data-controller="back" data-action="back#go" class="h-auto px-0 font-semibold text-wine">← Back</twig:Button>
    {% if isOwner %}
        <twig:Button as="a" variant="link" href="{{ path('app_collections') }}" class="h-auto px-0 font-semibold text-wine">All my collections</twig:Button>
    {% endif %}
</div>

<section class="neu flex flex-wrap items-center gap-6 rounded-[32px] p-7">
    <span class="inset flex size-24 flex-none items-center justify-center rounded-[24px] text-wine" aria-hidden="true">
        {% if collection.visibleCategory %}<twig:ux:icon name="{{ cat.icon(collection.visibleCategory.name) }}" class="size-10" />{% else %}<span class="font-serif text-4xl font-semibold">{{ collection.name|first|upper }}</span>{% endif %}
    </span>
    <div class="min-w-[240px] flex-1">
        <h1 class="text-[40px] leading-[1.1]">{{ collection.name }}</h1>
        <p class="mt-1 text-muted-ink">By <a href="{{ path('user_profile', {slug: collection.owner.username}) }}" class="font-semibold text-wine underline underline-offset-2">{{ collection.owner.username }}</a>{% if collection.visibleCategory %} · {{ collection.visibleCategory.name }}{% endif %} · {{ collection.public ? 'Public' : 'Private' }}</p>
        {% if collection.description %}<p class="mt-3 max-w-2xl">{{ collection.description }}</p>{% endif %}
    </div>
    <div class="flex flex-col items-end gap-2">
        {% if canEdit %}
            <twig:Button as="a" variant="neu" size="md" href="{{ path('app_collections_edit', {id: collection.id}) }}"><twig:ux:icon name="heroicons:pencil-square" class="size-5" />Edit</twig:Button>
        {% endif %}
        {% if not isOwner and (collection.public or isFollowing) %}
            <form method="post" action="{{ path(isFollowing ? 'app_collections_unfollow' : 'app_collections_follow', {id: collection.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('follow' ~ collection.id) }}">
                <twig:Button type="submit" variant="{{ isFollowing ? 'neu' : 'wine' }}" size="md">
                    <twig:ux:icon name="heroicons:user-plus" class="size-5" />{{ isFollowing ? 'Unfollow' : 'Follow' }}
                </twig:Button>
            </form>
        {% endif %}
        <span class="text-sm text-muted-ink">{{ collection.followers|length }} follower{{ collection.followers|length != 1 ? 's' : '' }}</span>
    </div>
</section>

<section aria-label="Items" class="flex flex-col gap-5">
    <div class="flex flex-wrap items-center justify-between gap-4">
        <h2 class="text-[28px]">Items <span class="text-lg text-muted-ink">({{ q ? entries|length ~ ' of ' : '' }}{{ collection.entries|length }})</span></h2>
        <form method="get" action="{{ path('app_collections_show', {id: collection.id}) }}" role="search" class="flex min-w-[200px] flex-1 items-center justify-end gap-3 sm:max-w-md">
            <label class="inset flex h-12 min-w-0 flex-1 items-center gap-2.5 rounded-full px-5 text-muted-ink focus-within:ring-2 focus-within:ring-wine/40">
                <twig:ux:icon name="heroicons:magnifying-glass" class="size-5 shrink-0" />
                <span class="sr-only">Search items</span>
                <input type="search" name="q" value="{{ q }}" placeholder="Search items" class="min-w-0 flex-1 bg-transparent text-base text-ink outline-none placeholder:text-muted-ink/80">
            </label>
            {% if q %}<twig:Button as="a" variant="link" href="{{ path('app_collections_show', {id: collection.id}) }}" class="h-auto px-0 font-semibold text-wine">Clear</twig:Button>{% endif %}
        </form>
        {% if canEdit %}
            <twig:Button as="a" variant="wine" size="md" href="{{ path('app_items_new', {id: collection.id}) }}"><twig:ux:icon name="heroicons:plus" class="size-5" />Add item</twig:Button>
        {% endif %}
    </div>
    <ul class="grid gap-6 [grid-template-columns:repeat(auto-fill,minmax(min(220px,100%),1fr))]">
        {% for entry in entries %}
            <li class="neu rounded-[28px] p-5">
                <span class="font-semibold">{{ entry.item.name }}</span>
                {% if entry.condition %}<span class="mt-1 block text-sm text-muted-ink">{{ entry.condition }}</span>{% endif %}
                {% if entry.notes %}<p class="mt-2 text-sm text-muted-ink">{{ entry.notes }}</p>{% endif %}
            </li>
        {% else %}
            <li class="col-span-full text-muted-ink">{{ q ? 'No item matches your search.' : 'No items yet.' }}</li>
        {% endfor %}
    </ul>
</section>
{% endblock %}
