{# Collections in one of three displays: `grouped` (a scrolling row per category), `grid` or `list` (one row each); the switch is _view_toggle.
   Params: collections (flat, ordered), groups, uncategorised, view, categoryLinks (show "See all" per category), empty (message),
   owner + type (username and list type, needed to link "N more…" when categoryLinks is false).
   In `grouped` each row shows only the cards that fit one line, the rest collapse into an "N more…" tile. #}
{% import '_macros/category.html.twig' as cat %}

{% if view == 'grouped' %}
    {% for group in groups %}
        <section aria-label="{{ group.category.name }}" class="flex flex-col gap-4">
            <div class="flex items-center justify-between gap-4">
                <h2 class="flex items-center gap-3 text-[24px]">
                    <span class="neu-sm flex size-11 items-center justify-center rounded-full text-wine"><twig:ux:icon name="{{ cat.icon(group.category.name) }}" class="size-5" /></span>
                    {{ group.category.name }}
                    <span class="font-sans text-sm font-medium text-muted-ink">{{ group.collections|length }}</span>
                </h2>
                {% if categoryLinks %}
                    <twig:Button as="a" variant="neu" size="pill" href="{{ path('app_collections_category', {slug: group.category.slug}) }}" class="shrink-0">See all</twig:Button>
                {% endif %}
            </div>
            {% set moreHref = categoryLinks ? path('app_collections_category', {slug: group.category.slug}) : path('user_collections', {slug: owner, type: type, view: 'grid', category: [group.category.slug]}) %}
            <div data-controller="rowfit" class="grid gap-6 [grid-template-columns:repeat(auto-fill,minmax(min(220px,100%),1fr))]">
                {% for collection in group.collections %}
                    {% include 'collections/_card.html.twig' %}
                {% endfor %}
                <a data-rowfit-target="more" href="{{ moreHref }}" style="display:none" class="inset flex min-h-32 items-center justify-center rounded-[28px] p-5 text-center text-[15px] font-semibold text-wine outline-none focus-visible:ring-2 focus-visible:ring-wine/40"><span><span data-count>0</span> more…</span></a>
            </div>
        </section>
    {% endfor %}

    {% if uncategorised %}
        <section aria-label="Uncategorised" class="flex flex-col gap-4">
            <h2 class="flex items-center gap-3 text-[24px]">
                <span class="neu-sm flex size-11 items-center justify-center rounded-full text-wine"><twig:ux:icon name="heroicons:tag" class="size-5" /></span>
                Uncategorised
                <span class="font-sans text-sm font-medium text-muted-ink">{{ uncategorised|length }}</span>
            </h2>
            <div data-controller="rowfit" class="grid gap-6 [grid-template-columns:repeat(auto-fill,minmax(min(220px,100%),1fr))]">
                {% for collection in uncategorised %}
                    {% include 'collections/_card.html.twig' %}
                {% endfor %}
                <a data-rowfit-target="more" href="{{ path(app.current_route, app.request.attributes.get('_route_params')|merge(app.request.query.all)|merge({view: 'grid'})) }}" style="display:none" class="inset flex min-h-32 items-center justify-center rounded-[28px] p-5 text-center text-[15px] font-semibold text-wine outline-none focus-visible:ring-2 focus-visible:ring-wine/40"><span><span data-count>0</span> more…</span></a>
            </div>
        </section>
    {% endif %}
{% elseif view == 'list' %}
    <section aria-label="Collections" class="flex flex-col gap-3">
        {% for collection in collections %}
            {% include 'collections/_row.html.twig' %}
        {% endfor %}
    </section>
{% else %}
    <section aria-label="Collections" class="grid gap-6 [grid-template-columns:repeat(auto-fill,minmax(min(220px,100%),1fr))]">
        {% for collection in collections %}
            {% include 'collections/_card.html.twig' with {showCategory: true} %}
        {% endfor %}
    </section>
{% endif %}

{% if not collections %}
    <p class="text-muted-ink">{{ empty }}</p>
{% endif %}
